from scipy.spatial.distance import pdist, squareform

def recurrence_plot(ts, epsilon):
    """Return recurrence matrix given time series and threshold epsilon."""
    distance_matrix = squareform(pdist(ts[:, None], metric='euclidean'))
    return distance_matrix < epsilon

def recurrence_quantification(R, l_min=2):
    """Compute recurrence rate and determinism from recurrence matrix R."""
    RR = np.sum(R) / R.size

    # Determinism: find diagonal lines of length >= l_min
    DET = 0
    total_diagonals = 0

    for k in range(-R.shape[0]+1, R.shape[1]):
        diag = np.diagonal(R, offset=k)
        length = 0
        for val in diag:
            if val:
                length += 1
            else:
                if length >= l_min:
                    DET += length
                length = 0
        if length >= l_min:
            DET += length

    DET /= np.sum(R) if np.sum(R) != 0 else 1
    return RR, DET

